{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-crash-diagnostic.invalid/schemas/exact-package-vm-evidence-v1.json",
  "title": "PC Crash Diagnostic exact-package VM evidence",
  "type": "object",
  "required": [
    "EvidenceSchemaVersion", "Product", "Version", "FeatureProfile",
    "RuntimeZipFileName", "RuntimeZipSize", "RuntimeZipSha256",
    "ReleaseManifestSha256", "ExecutableSha256", "SourceCommit", "SourceTag",
    "WindowsEdition", "WindowsBuild", "WindowsArchitecture", "VmSnapshotId",
    "AuthenticodeStatus", "SignerSubject", "SignerIssuer", "SignerThumbprint",
    "Rfc3161TimestampVerified", "TimestampAuthority", "DefenderScanPassed",
    "StandardUserLaunchPassed", "NoUacPromptObserved", "ReadOnlyBoundaryPassed",
    "RequiredFunctionalChecksPassed", "NoUnexpectedNetworkObserved",
    "NoPersistenceObserved", "NoSettingsMutationObserved",
    "NoUnexpectedChildProcessesObserved", "ExportPrivacyChecksPassed",
    "SmokeRuntimeVersion", "OverallResult", "EvidenceArtifactId", "TesterId",
    "ReviewerId", "TestedUtc", "ReviewedUtc"
  ],
  "properties": {
    "EvidenceSchemaVersion": { "const": 1 },
    "Product": { "const": "PC Crash Diagnostic" },
    "Version": { "const": "3.2.0-beta.1" },
    "FeatureProfile": { "const": "ShareReadOnly" },
    "RuntimeZipFileName": { "const": "PCCrashDiagnostic-3.2.0-beta.1-share-read-only-win-x64.zip" },
    "RuntimeZipSize": { "type": "integer", "minimum": 1 },
    "RuntimeZipSha256": { "$ref": "#/$defs/sha256" },
    "ReleaseManifestSha256": { "$ref": "#/$defs/sha256" },
    "ExecutableSha256": { "$ref": "#/$defs/sha256" },
    "SourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "SourceTag": { "const": "v3.2.0-beta.1" },
    "WindowsEdition": { "type": "string", "minLength": 1, "maxLength": 128 },
    "WindowsBuild": { "type": "string", "pattern": "^(?:10\\.0\\.)?[0-9]{5}(?:\\.[0-9]+){0,2}$" },
    "WindowsArchitecture": { "const": "x64" },
    "VmSnapshotId": { "$ref": "#/$defs/evidenceId" },
    "AuthenticodeStatus": { "const": "Valid" },
    "SignerSubject": { "type": "string", "minLength": 1, "maxLength": 512 },
    "SignerIssuer": { "type": "string", "minLength": 1, "maxLength": 512 },
    "SignerThumbprint": { "type": "string", "pattern": "^[0-9A-F]{40}$" },
    "Rfc3161TimestampVerified": { "const": true },
    "TimestampAuthority": { "type": "string", "minLength": 1, "maxLength": 512 },
    "DefenderScanPassed": { "const": true },
    "StandardUserLaunchPassed": { "const": true },
    "NoUacPromptObserved": { "const": true },
    "ReadOnlyBoundaryPassed": { "const": true },
    "RequiredFunctionalChecksPassed": { "const": true },
    "NoUnexpectedNetworkObserved": { "const": true },
    "NoPersistenceObserved": { "const": true },
    "NoSettingsMutationObserved": { "const": true },
    "NoUnexpectedChildProcessesObserved": { "const": true },
    "ExportPrivacyChecksPassed": { "const": true },
    "SmokeRuntimeVersion": { "const": "10.0.11" },
    "OverallResult": { "const": "Passed" },
    "EvidenceArtifactId": { "$ref": "#/$defs/evidenceId" },
    "TesterId": { "$ref": "#/$defs/evidenceId" },
    "ReviewerId": { "$ref": "#/$defs/evidenceId" },
    "TestedUtc": { "type": "string", "format": "date-time" },
    "ReviewedUtc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidenceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
  },
  "additionalProperties": false
}
