{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-crash-diagnostic.invalid/schemas/build-manifest-v3.json",
  "title": "PC Crash Diagnostic runtime build manifest schema 3",
  "type": "object",
  "required": [
    "ManifestSchemaVersion",
    "Product",
    "Version",
    "FeatureProfile",
    "CandidateState",
    "ShareApproved",
    "PrivilegedOperationsEnabled",
    "ElevatedHelperIncluded",
    "WerLocalDumpCaptureEnabled",
    "Capabilities",
    "Elevation",
    "SettingsMutation",
    "ProtectedEvidence",
    "Network",
    "Helper",
    "Configuration",
    "TargetFramework",
    "RuntimeIdentifier",
    "DotNetSdkVersion",
    "RuntimeFrameworkVersion",
    "BuiltUtc",
    "SourceRepository",
    "SourceOriginVerified",
    "SourceTag",
    "SourceTagVerified",
    "SourceCommit",
    "SourceTree",
    "SourceTreeState",
    "ExecutableName",
    "ExecutableSha256",
    "AuthenticodeStatus",
    "SignerSubject",
    "SignerIssuer",
    "SignerThumbprint",
    "TimestampSubject",
    "TimestampIssuer",
    "UnsignedSigningInputSha256",
    "SigningInputArtifactId",
    "TimestampCertificatePresent",
    "ReproducibleBuildVerified",
    "ReproducibilityPeerSha256",
    "Rfc3161TimestampVerified",
    "ExactPackageVmEvidenceVerified",
    "TestsExecuted",
    "TestEvidenceSha256",
    "SbomSha256",
    "ProvenanceSha256",
    "Files"
  ],
  "properties": {
    "ManifestSchemaVersion": { "const": 3 },
    "Product": { "const": "PC Crash Diagnostic" },
    "Version": { "const": "3.2.0-beta.1" },
    "FeatureProfile": { "const": "ShareReadOnly" },
    "CandidateState": {
      "enum": ["UnsignedCandidate", "UnsignedDirtyLocalCandidate", "SignedAwaitingExactPackageVmEvidence"]
    },
    "ShareApproved": { "const": false },
    "PrivilegedOperationsEnabled": { "const": false },
    "ElevatedHelperIncluded": { "const": false },
    "WerLocalDumpCaptureEnabled": { "const": false },
    "Capabilities": { "$ref": "#/$defs/capabilities" },
    "Elevation": { "const": "None" },
    "SettingsMutation": { "const": "None" },
    "ProtectedEvidence": { "const": "None" },
    "Network": { "const": "ConsentOnlyMicrosoftSymbols" },
    "Helper": { "const": "Absent" },
    "Configuration": { "const": "Release" },
    "TargetFramework": { "const": "net10.0-windows10.0.19041.0" },
    "RuntimeIdentifier": { "const": "win-x64" },
    "DotNetSdkVersion": { "const": "10.0.400" },
    "RuntimeFrameworkVersion": { "const": "10.0.11" },
    "BuiltUtc": { "type": "string", "format": "date-time" },
    "SourceRepository": { "const": "https://github.com/brads93/PCCrashDiagnostic" },
    "SourceOriginVerified": { "type": "boolean" },
    "SourceTag": { "type": ["string", "null"], "pattern": "^v3\\.2\\.0-beta\\.1$" },
    "SourceTagVerified": { "type": "boolean" },
    "SourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "SourceTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "SourceTreeState": { "enum": ["clean", "dirty"] },
    "ExecutableName": { "const": "PCCrashDiagnostic.exe" },
    "ExecutableSha256": { "$ref": "#/$defs/sha256" },
    "AuthenticodeStatus": { "type": "string", "minLength": 1 },
    "SignerSubject": { "type": ["string", "null"] },
    "SignerIssuer": { "type": ["string", "null"] },
    "SignerThumbprint": { "type": ["string", "null"], "pattern": "^[0-9A-F]{40}$" },
    "TimestampSubject": { "type": ["string", "null"] },
    "TimestampIssuer": { "type": ["string", "null"] },
    "UnsignedSigningInputSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "SigningInputArtifactId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "TimestampCertificatePresent": { "type": "boolean" },
    "Rfc3161TimestampVerified": { "type": "boolean" },
    "ReproducibleBuildVerified": { "type": "boolean" },
    "ReproducibilityPeerSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "ExactPackageVmEvidenceVerified": { "const": false },
    "TestsExecuted": { "const": true },
    "TestEvidenceSha256": { "$ref": "#/$defs/sha256" },
    "SbomSha256": { "$ref": "#/$defs/sha256" },
    "ProvenanceSha256": { "$ref": "#/$defs/sha256" },
    "Files": { "type": "array", "items": { "$ref": "#/$defs/file" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capabilities": {
      "type": "object",
      "required": ["Profile", "StandardEvidence", "TargetMonitoring", "CrashReadinessReadOnly", "AccessibleDumpMetadata", "LocalHistory", "SafeSummaryExport", "TechnicalReportExport", "RecycleBinDeletion", "DumpChk", "WinDbg", "MicrosoftSymbolsAfterConsent", "ElevatedHelper", "SettingsApply", "SettingsRestore", "WerLocalDumps", "ProtectedEvidence", "ProtectedDumpStaging", "DumpPackaging"],
      "properties": {
        "Profile": { "const": "ShareReadOnly" },
        "StandardEvidence": { "const": true }, "TargetMonitoring": { "const": true },
        "CrashReadinessReadOnly": { "const": true }, "AccessibleDumpMetadata": { "const": true },
        "LocalHistory": { "const": true }, "SafeSummaryExport": { "const": true },
        "TechnicalReportExport": { "const": true }, "RecycleBinDeletion": { "const": true },
        "DumpChk": { "const": true }, "WinDbg": { "const": true },
        "MicrosoftSymbolsAfterConsent": { "const": true }, "ElevatedHelper": { "const": false },
        "SettingsApply": { "const": false }, "SettingsRestore": { "const": false },
        "WerLocalDumps": { "const": false }, "ProtectedEvidence": { "const": false },
        "ProtectedDumpStaging": { "const": false }, "DumpPackaging": { "const": false }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": ["Path", "Size", "Sha256"],
      "properties": {
        "Path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\./)(?!.*:).+$" },
        "Size": { "type": "integer", "minimum": 0 },
        "Sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
