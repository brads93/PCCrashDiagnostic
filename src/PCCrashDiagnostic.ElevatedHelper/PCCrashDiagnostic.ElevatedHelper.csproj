<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <AssemblyName>PCCrashDiagnostic.ElevatedHelper</AssemblyName>
    <RootNamespace>PCCrashDiagnostic.ElevatedHelper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PCCrashDiagnostic.Privileged\PCCrashDiagnostic.Privileged.csproj" />
  </ItemGroup>
  <Target Name="ValidateInternalHelperProfile" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PCCrashDiagnosticFeatureProfile)' != 'FullDiagnostic' and '$(PCCrashDiagnosticFeatureProfile)' != 'WerResearch'"
           Text="PCCrashDiagnostic.ElevatedHelper is internal-only and requires FullDiagnostic or WerResearch." />
  </Target>
</Project>
