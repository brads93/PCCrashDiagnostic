<Window x:Class="BF6CrashDiagnostic.App.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review report summary"
        Width="760"
        Height="650"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        AutomationProperties.Name="Review diagnostic summary">
    <Grid Margin="28" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Review report summary" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="This window shows the report summary. The app does not upload files." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,14" Style="{StaticResource CardStyle}" Padding="16">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Standard report" />
                <TextBlock Margin="0,7,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="The ZIP includes system details, selected Windows event messages, and session counters when monitoring was used. Crash dump contents are excluded. Share the ZIP only with someone you trust." />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    Foreground="{StaticResource TextBrush}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter Property="Padding" Value="12,7" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabChrome"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1,1,1,0">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabChrome" Property="Background" Value="#243348" />
                                        <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Summary">
                <TextBox Margin="12"
                         Text="{Binding Summary, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Report summary" />
            </TabItem>
            <TabItem Header="Unavailable data">
                <Grid Margin="16">
                    <TextBlock Text="All requested sources were read."
                               Foreground="{StaticResource MutedTextBrush}"
                               Visibility="{Binding NoFailuresVisibility}" />
                    <ListBox ItemsSource="{Binding CollectionFailures}"
                             Background="Transparent"
                             BorderThickness="0"
                             Visibility="{Binding FailuresVisibility}"
                             AutomationProperties.Name="Collection failures">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,5" Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="130"
                    Style="{StaticResource ButtonBaseStyle}"
                    Content="Copy summary"
                    Click="CopySummary_Click"
                    AutomationProperties.Name="Copy summary" />
            <Button Width="100"
                    Margin="10,0,0,0"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Done"
                    Click="Done_Click" />
        </StackPanel>
    </Grid>
</Window>
