<Window x:Class="BF6CrashDiagnostic.App.CrashPreparationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prepare Windows crash capture"
        Width="760"
        Height="700"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        AutomationProperties.Name="Prepare Windows crash capture">
    <Grid Margin="28" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="25" FontWeight="SemiBold" Text="{Binding Heading}" TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding Introduction}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,20,0,18" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Text="CURRENT" />
                            <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="{Binding CurrentSummary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16" BorderBrush="{StaticResource AccentBrush}">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="PROPOSED" />
                            <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="{Binding ProposedSummary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Changes" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Changes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,4,0,0" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Before you continue" />
                        <TextBlock Margin="0,9,0,0" FontWeight="SemiBold" Text="Disk space" />
                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding DiskImpact}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="Privacy" />
                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding PrivacyImpact}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="Restart" />
                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding RestartImpact}" TextWrapping="Wrap" />
                        <StackPanel Visibility="{Binding PerAppVisibility}">
                            <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="App crash dumps" />
                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding PerAppCaptureSummary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding UacNotice}"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal">
                <Button Width="100"
                        IsCancel="True"
                        Style="{StaticResource ButtonBaseStyle}"
                        Content="Cancel" />
                <Button Width="190"
                        Margin="10,0,0,0"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="{Binding ActionText}"
                        Click="Continue_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
