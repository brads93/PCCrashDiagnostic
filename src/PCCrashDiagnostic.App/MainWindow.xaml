<Window x:Class="PCCrashDiagnostic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="PC Crash Diagnostic"
        MinWidth="640" MinHeight="480"
        automation:AutomationProperties.Name="PC Crash Diagnostic 3.2.0 beta 1 ShareReadOnly"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0F1925" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="28,20">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="24" FontWeight="SemiBold" Text="PC Crash Diagnostic" />
          <TextBlock x:Name="BuildIdentityText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="3.2.0-beta.1 · ShareReadOnly · does not request administrator access" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" Margin="18,0,0,0">
          <TextBlock x:Name="UploadStatementText" Foreground="#69D7A8" TextAlignment="Right" TextWrapping="Wrap" Text="PC Crash Diagnostic does not upload" />
          <TextBlock Foreground="{StaticResource MutedBrush}" TextAlignment="Right" TextWrapping="Wrap" Text="Evidence and reports stay local until you export them" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30">
      <Grid MaxWidth="1040">
        <StackPanel x:Name="StartPanel" automation:AutomationProperties.AutomationId="StartScreen">
          <TextBlock x:Name="StartHeading" Focusable="True" FontSize="30" FontWeight="SemiBold" Text="What happened?" Margin="0,0,0,8" />
          <TextBlock Foreground="{StaticResource MutedBrush}" Text="Choose the closest match. The app only reads diagnostic evidence." Margin="0,0,0,20" />

          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock x:Name="TimeRangeLabel" FontWeight="SemiBold" Text="How far back should Windows be checked?" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <ComboBox x:Name="TimeRangeCombo" Width="220" SelectedIndex="1" SelectionChanged="TimeRangeCombo_SelectionChanged"
                          automation:AutomationProperties.AutomationId="TimeRange"
                          automation:AutomationProperties.LabeledBy="{Binding ElementName=TimeRangeLabel}">
                  <ComboBoxItem Content="Last 24 hours" Tag="1" />
                  <ComboBoxItem Content="Last 7 days" Tag="7" />
                  <ComboBoxItem Content="Last 14 days" Tag="14" />
                  <ComboBoxItem Content="Custom number of days" Tag="custom" />
                </ComboBox>
                <TextBlock x:Name="CustomDaysLabel" Text="Days:" Margin="12,0,6,0" VerticalAlignment="Center" />
                <TextBox x:Name="CustomDaysText" Width="90" Padding="8" Text="7" IsEnabled="False"
                          ToolTip="Enter 1 to 31 days when Custom is selected"
                          automation:AutomationProperties.AutomationId="CustomDays"
                          automation:AutomationProperties.LabeledBy="{Binding ElementName=CustomDaysLabel}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Button x:Name="BlueScreenButton" Click="BlueScreenButton_Click" automation:AutomationProperties.AutomationId="BlueScreenChoice"
                  automation:AutomationProperties.Name="Windows restarted or showed a blue screen">
            <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="Windows restarted or showed a blue screen" /><TextBlock Foreground="{StaticResource MutedBrush}" Text="Find bugcheck, restart, dump, WHEA, storage, and driver evidence" /></StackPanel>
          </Button>
          <Button x:Name="AppClosedButton" Click="AppClosedButton_Click" automation:AutomationProperties.AutomationId="AppClosedChoice"
                  automation:AutomationProperties.Name="An app or game closed or froze">
            <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="An app or game closed or froze" /><TextBlock Foreground="{StaticResource MutedBrush}" Text="Choose the program and look for related application evidence" /></StackPanel>
          </Button>
          <Button x:Name="MonitorButton" Click="MonitorButton_Click" automation:AutomationProperties.AutomationId="MonitorChoice"
                  automation:AutomationProperties.Name="Monitor an app for the next problem">
            <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="Monitor an app for the next problem" /><TextBlock Foreground="{StaticResource MutedBrush}" Text="Watch matching process counters without reading process memory or input" /></StackPanel>
          </Button>
          <Button x:Name="OpenReportButton" Click="OpenReportButton_Click" automation:AutomationProperties.AutomationId="OpenReportChoice"
                  automation:AutomationProperties.Name="Open a previous report">
            <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="Open a previous report" /><TextBlock Foreground="{StaticResource MutedBrush}" Text="Validate and review a local PC Crash Diagnostic report" /></StackPanel>
          </Button>

          <Expander Header="Local report history" Margin="0,18,0,0" Expanded="HistoryExpander_Expanded">
            <StackPanel Margin="0,12,0,0">
              <ListBox x:Name="HistoryList" MinHeight="100" DisplayMemberPath="DisplayText"
                       automation:AutomationProperties.AutomationId="HistoryList"
                       automation:AutomationProperties.Name="Local report history" />
              <WrapPanel Margin="0,8,0,0">
                <Button Click="OpenHistoryButton_Click" Content="Open selected" Margin="0,0,8,0" />
                <Button Click="RecycleHistoryButton_Click" Content="Move selected to Recycle Bin" Margin="0,0,8,0" />
                <Button Click="RecycleAllButton_Click" Content="Move all history to Recycle Bin" />
              </WrapPanel>
              <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Recycle Bin deletion is recoverable and is not secure erasure. Restored reports may reappear in history." />
            </StackPanel>
          </Expander>
        </StackPanel>

        <StackPanel x:Name="CollectingPanel" Visibility="Collapsed" automation:AutomationProperties.AutomationId="CollectingScreen">
          <TextBlock x:Name="CollectingHeading" Focusable="True" FontSize="30" FontWeight="SemiBold" Text="Collecting Windows evidence" />
          <TextBlock x:Name="CollectingStatusText" Foreground="{StaticResource MutedBrush}" Text="Starting…" Margin="0,8,0,18" TextWrapping="Wrap"
                     automation:AutomationProperties.LiveSetting="Polite" />
          <ProgressBar x:Name="CollectingProgress" Height="8" IsIndeterminate="True" />
          <Button Click="CancelButton_Click" Content="Cancel" HorizontalAlignment="Left" Margin="0,20,0,0" automation:AutomationProperties.AutomationId="CancelCollection" />
        </StackPanel>

        <StackPanel x:Name="ResultsPanel" Visibility="Collapsed" automation:AutomationProperties.AutomationId="ResultsScreen">
          <TextBlock x:Name="ResultsHeading" Focusable="True" FontSize="30" FontWeight="SemiBold" Text="Results" />
          <TextBlock x:Name="ResultIncidentText" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,18" TextWrapping="Wrap"
                     automation:AutomationProperties.LiveSetting="Polite" />

          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,16"
                  automation:AutomationProperties.AutomationId="EvidenceCollected">
            <StackPanel>
              <TextBlock FontSize="21" FontWeight="SemiBold" Text="Evidence collected" />
              <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"
                         Text="Ordered by relevance to the selected incident. The order and badges describe the observation, not confidence in a root cause." />
              <ItemsControl x:Name="EvidenceItems">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#30465C" BorderThickness="0,1,0,0" Padding="0,12">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" FontSize="17" Text="{Binding Title}" />
                        <TextBlock Foreground="#72CFFF" FontWeight="SemiBold" Text="{Binding EvidenceLabel}" />
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Observed}" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Relevance}" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="{Binding Limitation}" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="{Binding NextCheck}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="NoEvidenceText" Visibility="Collapsed" TextWrapping="Wrap" Text="No cause was identified in the Windows records this app could read." />
            </StackPanel>
          </Border>

          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,16"
                  automation:AutomationProperties.AutomationId="CrashReadiness">
            <StackPanel>
              <TextBlock FontSize="21" FontWeight="SemiBold" Text="Crash capture readiness" />
              <TextBlock x:Name="ReadinessStateText" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
              <TextBlock x:Name="ReadinessCapturedText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
              <TextBlock x:Name="ReadinessDetailText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
              <TextBlock Foreground="{StaticResource MutedBrush}" Text="Read-only check; this build cannot change Windows settings." Margin="0,8,0,0" />
            </StackPanel>
          </Border>

          <Border x:Name="LocalToolsCard" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,16"
                  automation:AutomationProperties.AutomationId="OptionalLocalDumpAnalysis">
            <StackPanel>
              <TextBlock FontSize="21" FontWeight="SemiBold" Text="Optional local dump analysis" />
              <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"
                         Text="Available only for a dump this report correlated to the selected incident. No dump is uploaded. These tools do not confirm a faulty driver." />
              <TextBlock x:Name="DebuggerAvailabilityText" TextWrapping="Wrap" />
              <TextBlock x:Name="DumpCheckerAvailabilityText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,8" />
              <ListBox x:Name="LocalDumpList" MinHeight="54" DisplayMemberPath="DisplayText" SelectedIndex="0"
                       automation:AutomationProperties.AutomationId="CorrelatedDumpChoices"
                       automation:AutomationProperties.Name="Correlated crash dumps" />
              <WrapPanel Margin="0,8,0,0">
                <Button x:Name="BuiltInDumpCheckButton" Click="BuiltInDumpCheckButton_Click" Content="Run bounded dump check" Margin="0,4,8,4" />
                <Button x:Name="DumpChkButton" Click="DumpChkButton_Click" Content="Run Microsoft DumpChk" Margin="0,4,8,4" />
                <Button x:Name="WinDbgOfflineButton" Click="WinDbgOfflineButton_Click" Content="Run WinDbg offline" Margin="0,4,8,4" />
                <Button x:Name="WinDbgSymbolsButton" Click="WinDbgSymbolsButton_Click" Content="Download Microsoft symbols and retry" Margin="0,4,8,4" />
              </WrapPanel>
              <TextBlock x:Name="LocalToolsResultText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
              <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0">
                <Hyperlink NavigateUri="https://learn.microsoft.com/windows-hardware/drivers/debugger/" RequestNavigate="OfficialWinDbgLink_RequestNavigate">Microsoft's official WinDbg install page</Hyperlink>
                <Run Text=" (the app never installs it automatically)." />
              </TextBlock>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock FontSize="21" FontWeight="SemiBold" Text="Source coverage" />
              <ItemsControl x:Name="CoverageItems" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,2" TextWrapping="Wrap" Text="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Button x:Name="ReviewSafeSummaryButton" Click="ReviewSafeSummaryButton_Click" Background="{StaticResource PrimaryBrush}" FontWeight="SemiBold" HorizontalContentAlignment="Center"
                  Content="Review safe summary" automation:AutomationProperties.AutomationId="ReviewSafeSummary" />

          <Expander x:Name="TechnicalReportExportExpander" Header="Export the full technical report (advanced)" Margin="0,12,0,0" automation:AutomationProperties.AutomationId="TechnicalReportExport">
            <StackPanel Margin="0,10,0,0">
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                         Text="The technical ZIP contains structured Windows evidence, device and driver labels, and collection details. It does not contain dump bytes or raw debugger logs. Review the privacy warning before sharing it." />
              <CheckBox x:Name="TechnicalReportConfirm" Margin="0,10,0,0" Content="I understand this contains more technical detail than the safe summary." />
              <Button Click="ExportTechnicalReportButton_Click" Content="Save technical report ZIP" HorizontalAlignment="Left" />
            </StackPanel>
          </Expander>

          <WrapPanel Margin="0,18,0,0">
            <Button Click="StartOverButton_Click" Content="Start over" Margin="0,0,8,0" />
            <Button Click="RecycleCurrentButton_Click" Content="Move this local report to Recycle Bin" />
          </WrapPanel>
        </StackPanel>

        <StackPanel x:Name="PreviewPanel" Visibility="Collapsed" automation:AutomationProperties.AutomationId="SafeSummaryPreviewScreen">
          <TextBlock x:Name="PreviewHeading" Focusable="True" FontSize="30" FontWeight="SemiBold" Text="Review exactly what will be shared" />
          <TextBlock Foreground="{StaticResource MutedBrush}" Text="Copy and Save use these exact bytes." Margin="0,5,0,12" />
          <TextBox x:Name="SafeSummaryText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" MinHeight="330" automation:AutomationProperties.AutomationId="SafeSummaryText"
                   automation:AutomationProperties.Name="Exact safe summary preview" />
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,14,0"><TextBlock FontWeight="SemiBold" Text="Included" /><ItemsControl x:Name="IncludedItems" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="Always excluded" /><ItemsControl x:Name="ExcludedItems" /></StackPanel>
          </Grid>
          <WrapPanel Margin="0,18,0,0">
            <Button Click="BackToResultsButton_Click" Content="Back" Margin="0,0,8,0" />
            <Button Click="CopySafeSummaryButton_Click" Content="Copy safe summary" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="CopySafeSummary" />
            <Button Click="SaveSafeSummaryButton_Click" Content="Save safe summary" Background="{StaticResource PrimaryBrush}" FontWeight="SemiBold"
                    automation:AutomationProperties.AutomationId="SaveSafeSummary" />
          </WrapPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
      <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Unofficial community diagnostic · MIT licensed · no automatic repairs · not affiliated with EA, DICE, or Microsoft" />
    </Border>
  </Grid>
</Window>
