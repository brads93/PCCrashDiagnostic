<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PCCrashDiagnostic</AssemblyName>
    <RootNamespace>PCCrashDiagnostic.App</RootNamespace>
    <AssemblyTitle>PC Crash Diagnostic</AssemblyTitle>
    <Product>PC Crash Diagnostic</Product>
    <Description>Read-only Windows crash and blue-screen evidence collector.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PCCrashDiagnostic.Contracts\PCCrashDiagnostic.Contracts.csproj" />
    <ProjectReference Include="..\PCCrashDiagnostic.Core\PCCrashDiagnostic.Core.csproj" />
    <ProjectReference Include="..\PCCrashDiagnostic.LocalTools\PCCrashDiagnostic.LocalTools.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PCCrashDiagnostic.Share.Tests" />
  </ItemGroup>
  <Target Name="ValidateShareReadOnlyApplicationProfile" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PCCrashDiagnosticFeatureProfile)' != 'ShareReadOnly'"
           Text="PCCrashDiagnostic.App is the public ShareReadOnly application and cannot be compiled under an internal feature profile." />
  </Target>
</Project>
